---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getAllProducts } from '../lib/sanity';

/* NESTED model: one product doc = one design, holding variants[] per garment.
   Card image = first variant's first colour mockup; price = cheapest size
   across all variants ("From £X"). Only active products are returned. */
const sanityProducts = await getAllProducts();

const fromPrice = (p) => {
  const prices = (p.variants || []).flatMap((v) => {
    const sp = (v.sizePrices || []).map((s) => s.price).filter((n) => typeof n === 'number');
    return sp.length ? sp : (typeof v.basePrice === 'number' ? [v.basePrice] : []);
  });
  return prices.length ? Math.min(...prices) : null;
};
const cardImage = (p) => {
  const v = p.variants?.[0];
  return v?.colourImages?.[0]?.imageUrl || v?.printfulImageUrl || null;
};

const products = (sanityProducts || []).map((p) => ({
  name: p.name,
  slug: p.slug,
  price: fromPrice(p),
  image: cardImage(p),
  alt: p.name,
  blurb: p.description || p.tagline || '',
}));
---

<Layout title="Merch — Labrats" description="Official Labrats merchandise. Tees, hoodies, tanks, long sleeves, tumblers and more. Wear your rebellion." canonical="/merch">
  <Navbar />
  <main class="page">

    <section class="page-hero">
      <div class="container page-hero__content">
        <span class="page-hero__label">Official Merch</span>
        <h1 class="page-hero__title">Gear Up, Rebel</h1>
        <p class="page-hero__subtitle">Official Labrats merchandise. Wear your rebellion.</p>
      </div>
    </section>

    <section class="products-section">
      <div class="container">
        <div class="products-grid">
          {products.map((product) => (
            <a class="product-card" href={`/product/${product.slug}`}>
              <div class="product-card__img-wrap">
                {product.image ? (
                  <img
                    src={product.image}
                    alt={product.alt}
                    class="product-card__img"
                    loading="lazy"
                  />
                ) : (
                  <div class="product-card__placeholder">
                    <span class="product-card__placeholder-label">Labrats</span>
                  </div>
                )}
                <div class="product-card__overlay">
                  <span class="product-card__quick-view">View Product</span>
                </div>
              </div>
              <div class="product-card__body">
                <p class="product-card__name">{product.name}</p>
                {product.blurb && <p class="product-card__blurb">{product.blurb}</p>}
                {product.price != null && <p class="product-card__price">From £{product.price.toFixed(2)}</p>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="newsletter">
      <div class="newsletter__inner">
        <p class="newsletter__text">
          New designs drop regularly.&nbsp;
          <span class="newsletter__highlight">Join the newsletter for first dibs.</span>
        </p>
        <form
          class="newsletter__form"
          id="merchWaitlistForm"
        >
          <div class="newsletter__input-wrap">
            <input
              type="email"
              name="email"
              id="merch-email"
              placeholder="Enter your email address..."
              class="newsletter__input"
              required
              autocomplete="email"
            />
            <button type="submit" class="newsletter__submit">Subscribe</button>
          </div>
        </form>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .page {
    padding-top: 80px;
    background: var(--color-white);
    min-height: 100vh;
  }

  .page-hero {
    background: var(--color-black);
    padding: 88px 0 72px;
    border-bottom: 2px solid var(--color-teal);
  }

  .page-hero__content {
    max-width: 700px;
  }

  .page-hero__label {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-teal);
    margin-bottom: 12px;
  }

  .page-hero__title {
    font-family: var(--font-display);
    font-size: clamp(44px, 7vw, 96px);
    font-weight: 900;
    color: var(--color-yellow);
    line-height: 1;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .page-hero__subtitle {
    font-family: var(--font-heading);
    font-size: clamp(16px, 2vw, 21px);
    font-weight: 600;
    color: var(--color-white);
    opacity: 0.8;
  }

  .products-section {
    padding: 64px 0 80px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 24px;
  }

  .product-card {
    display: block;
    text-decoration: none;
  }

  .product-card__img-wrap {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: #f0f0f0;
    border: 1px solid rgba(10, 10, 10, 0.08);
  }

  .product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card__img {
    transform: scale(1.04);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-teal) 8%, #ffffff);
  }

  .product-card__placeholder-label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .product-card__overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-black) 50%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    border-radius: 10px;
  }

  .product-card:hover .product-card__overlay {
    opacity: 1;
  }

  .product-card__quick-view {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-yellow);
    border: 2px solid var(--color-yellow);
    padding: 10px 18px;
    border-radius: var(--radius);
  }

  .product-card__body {
    padding: 14px 4px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-card__name {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-black);
    letter-spacing: 0.3px;
  }

  .product-card__blurb {
    font-family: var(--font-body);
    font-size: 13px;
    color: rgba(10, 10, 10, 0.55);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__price {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-teal);
  }

  .newsletter {
    background: var(--color-black);
    padding: 64px 24px;
    display: flex;
    justify-content: center;
  }

  .newsletter__inner {
    max-width: 600px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .newsletter__text {
    font-family: var(--font-heading);
    font-size: clamp(16px, 2vw, 20px);
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.5;
  }

  .newsletter__highlight {
    color: var(--color-yellow);
  }

  .newsletter__form {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .newsletter__input-wrap {
    display: flex;
    width: 100%;
    max-width: 520px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-teal) 40%, transparent);
  }

  .newsletter__input {
    flex: 1;
    background: color-mix(in srgb, var(--color-white) 8%, var(--color-black));
    border: none;
    padding: 16px 20px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-white);
    outline: none;
    transition: background 0.2s;
  }

  .newsletter__input::placeholder {
    color: color-mix(in srgb, var(--color-white) 50%, transparent);
  }

  .newsletter__input:focus {
    background: color-mix(in srgb, var(--color-white) 12%, var(--color-black));
  }

  .newsletter__submit {
    flex-shrink: 0;
    padding: 16px 28px;
    white-space: nowrap;
    background: var(--color-teal);
    color: var(--color-black);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .newsletter__submit:hover {
    background: color-mix(in srgb, var(--color-teal) 80%, var(--color-white));
  }

  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .products-grid {
      grid-template-columns: 1fr;
    }

    .products-section {
      padding: 48px 0 64px;
    }

    .newsletter__input-wrap {
      flex-direction: column;
      border-radius: var(--radius-lg);
      overflow: visible;
      box-shadow: none;
      gap: 8px;
    }

    .newsletter__input {
      border-radius: var(--radius);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-teal) 40%, transparent);
    }

    .newsletter__submit {
      border-radius: var(--radius);
      width: 100%;
    }
  }
</style>

<script>
  (function () {
    const form = document.getElementById('merchWaitlistForm') as HTMLFormElement;
    if (!form) return;
    const btn = form.querySelector('.newsletter__submit') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('merch-email') as HTMLInputElement)?.value?.trim();
      if (!email) return;

      const originalText = btn.textContent;
      btn.textContent = 'Subscribing...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email,
            groups: ['184360862869358023'],
            fields: { source: 'labrats-merch-newsletter' }
          })
        });

        if (res.ok || res.status === 200 || res.status === 201) {
          btn.textContent = "You're on the list!";
          (document.getElementById('merch-email') as HTMLInputElement).value = '';
          setTimeout(() => { btn.textContent = originalText; btn.disabled = false; }, 4000);
        } else if (res.status === 422) {
          btn.textContent = "You're already on the list!";
          (document.getElementById('merch-email') as HTMLInputElement).value = '';
          setTimeout(() => { btn.textContent = originalText; btn.disabled = false; }, 3000);
        } else {
          throw new Error('Failed');
        }
      } catch {
        btn.textContent = 'Something went wrong — try again';
        btn.disabled = false;
        setTimeout(() => { btn.textContent = originalText; }, 3000);
      }
    });
  })();
</script>
