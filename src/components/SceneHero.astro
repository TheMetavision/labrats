---
// Full-bleed scene image behind a page hero. Drop it as the first child of
// the hero <section> and add class="has-scene" to that section; the section's
// own copy stays as it is and sits over the dark left side of the picture.
// Phones: the picture becomes a 3:2 band above the copy.
import { localImg, localSrcset } from '../lib/sanityImage';

interface Props {
  src: string;          // /public path, e.g. /images/heroes/rat-pack.webp
  alt: string;
  width?: number;       // original pixel width of the file
  height?: number;
  position?: string;    // object-position for wide screens
  navOffset?: number;   // px of fixed nav the section sits under (0 when <main> is already padded)
}
const { src, alt, width = 2400, height = 1600, position = '78% 40%', navOffset = 0 } = Astro.props;
---
<img
  class="scene-hero__img"
  src={localImg(src, 1600)}
  srcset={localSrcset(src, 1920, width)}
  sizes="100vw"
  width={width}
  height={height}
  alt={alt}
  fetchpriority="high"
  style={`--scene-pos:${position};--scene-top:${navOffset}px`}
/>
<div class="scene-hero__shade" style={`--scene-top:${navOffset}px`} aria-hidden="true"></div>

<style>
  :global(section.has-scene) {
    position: relative;
    overflow: hidden;
    min-height: min(72vh, 680px);
    display: flex;
    align-items: center;
    background: #0a0a0a;
  }
  :global(.has-scene > .container) { position: relative; z-index: 2; width: 100%; }
  :global(.has-scene > .container > *) { max-width: 470px !important; }
  :global(.has-scene .page-hero__title) { font-size: clamp(44px, 6vw, 96px) !important; }
  :global(.has-scene .page-hero__bg) { display: none; }
  :global(.has-scene.page-hero::after) { display: none; }

  .scene-hero__img {
    position: absolute;
    top: var(--scene-top, 0);
    right: 0;
    width: 60%;
    height: calc(100% - var(--scene-top, 0px));
    object-fit: cover;
    object-position: var(--scene-pos, 60% 40%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 18%);
    z-index: 0;
  }
  .scene-hero__shade {
    position: absolute;
    inset: var(--scene-top, 0) 0 0 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.7) 34%, rgba(10,10,10,0.1) 52%, transparent 100%),
      linear-gradient(0deg, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0) 28%);
  }

  @media (max-width: 1024px) {
    .scene-hero__img { width: 100%; -webkit-mask-image: none; mask-image: none; }
    .scene-hero__shade {
      background:
        linear-gradient(90deg, rgba(10,10,10,0.9) 0%, rgba(10,10,10,0.55) 55%, rgba(10,10,10,0.25) 100%),
        linear-gradient(0deg, rgba(10,10,10,0.85) 0%, rgba(10,10,10,0) 35%);
    }
  }
  @media (max-width: 768px) {
    :global(section.has-scene) { display: block; min-height: 0; padding-top: 0 !important; }
    .scene-hero__img {
      position: relative;
      top: 0;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      display: block;
      margin-top: var(--scene-top, 0);
      margin-bottom: 28px;
    }
    .scene-hero__shade { display: none; }
  }
</style>
