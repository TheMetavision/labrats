---
import { sanityImg } from '../lib/sanityImage';
import { getSiteSettings, urlFor } from '../lib/sanity';
import LegalLinks from './LegalLinks.astro';
import { SOCIAL_LINKS } from '../lib/socialLinks';

const settings = await getSiteSettings();

const exploreLinks = [
  { label: 'Home', href: '/' },
  { label: 'Media', href: '/media' },
  { label: 'Games', href: '/games' },
  { label: 'Merch', href: '/merch' },
  { label: 'Rat Tales', href: '/rat-tales' },
  { label: 'Meet The Rat Pack', href: '/meet-the-rat-pack' },
  { label: 'Contact', href: '/contact' },
];

const socialSvgs: Record<string, string> = {
  facebook: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
  youtube: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
  tiktok: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>',
  instagram: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>',
};

// The same accounts as the header, from the one shared list (src/lib/socialLinks.ts).
// They used to come from Sanity siteSettings.socialLinks, which still holds the
// old handles; the header never read it, so the two had drifted apart.
const socials = SOCIAL_LINKS.map((s) => ({ icon: s.label.toLowerCase(), href: s.href, label: s.label }));

/* A logo at a given display height: width-sized URLs (1x and 2x) and its
   intrinsic width/height, from the asset's own dimensions. */
function logoAt(source: any, displayH: number) {
  const base = urlFor(source).url();
  const m = base.match(/-(\d+)x(\d+)\.\w+/);
  const w = m ? Math.round(displayH * Number(m[1]) / Number(m[2])) : displayH * 2;
  return {
    src: sanityImg(base, w),
    srcset: `${sanityImg(base, w)} 1x, ${sanityImg(base, w * 2)} 2x`,
    width: w,
    height: displayH,
  };
}
// Shown 140px high.
const footerLogoSource = settings?.footerLogo || settings?.logo;
const footerLogo = footerLogoSource ? logoAt(footerLogoSource, 140) : null;

const footerText = settings?.footerText || 'Join the rebellion.\nUnleash the mischief.';
---

<footer class="footer">
  <div class="container">
    <div class="footer__main">
      <div class="footer__brand">
        {footerLogo && (
          <img {...footerLogo} alt="Labrats" class="footer__logo" />
        )}
        <p class="footer__tagline">
          {footerText.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              <em>{line}</em>
            </>
          ))}
        </p>
      </div>

      <nav class="footer__nav" aria-label="Explore navigation">
        <h3 class="footer__nav-title">Explore</h3>
        <ul class="footer__links">
          {exploreLinks.map(link => (
            <li>
              <a href={link.href} class="footer__link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer__nav" aria-label="Legal navigation">
        <h3 class="footer__nav-title">Legal</h3>
        <LegalLinks />
        <button type="button" class="footer__link footer__cookie" data-cookie-settings>Cookie settings</button>
      </nav>

      <div class="footer__connect">
        <h3 class="footer__nav-title">Connect</h3>
        <div class="footer__social-row">
          {socials.map(s => (
            <a
              href={s.href}
              class="footer__social-icon"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              set:html={socialSvgs[s.icon]}
            ></a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        © {new Date().getFullYear()} Labrats. All rights reserved.
      </p>
      <p class="footer__copyright footer__legal">
        Labrats is a trading name of The Metavision Multimedia Limited.
        Registered in England &amp; Wales, company no. 16282479.
        Registered office: 167-169 Great Portland Street, 5th Floor, London, W1W 5PF.
        VAT no. GB 503 7530 17.
        <a href="mailto:squeak@labrats.uk">squeak@labrats.uk</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer__legal {
    font-size: 0.72rem;
    line-height: 1.6;
    max-width: 60rem;
    margin: 0.5rem auto 0;
    opacity: 0.8;
  }
  .footer__legal a { color: inherit; }

  .footer {
    background: var(--color-black);
    color: var(--color-white);
    padding: 64px 0 32px;
  }

  .footer__main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__logo {
    height: 140px;
    width: auto;
    align-self: flex-start;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--color-white);
    opacity: 0.8;
    line-height: 1.5;
    max-width: 260px;
  }

  .footer__nav-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-yellow);
    margin-bottom: 16px;
  }

  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0;
    margin: 0;
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-white);
    opacity: 0.8;
    transition: opacity 0.2s, color 0.2s;
    text-decoration: none;
  }

  .footer__link:hover {
    opacity: 1;
    color: var(--color-yellow);
  }

  /* "Cookie settings" reopens the consent banner; styled as a footer link. */
  .footer__cookie {
    display: inline-block;
    margin-top: 8px;
    padding: 0;
    font-weight: 400;
    letter-spacing: 0;
    text-align: inherit;
  }

  .footer__connect {
    display: flex;
    flex-direction: column;
  }

  .footer__social-row {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .footer__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    color: var(--color-yellow);
    transition: color 0.2s, background 0.2s;
  }

  .footer__social-icon:hover {
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-yellow) 20%, transparent);
  }

  .footer__bottom {
    border-top: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    padding-top: 24px;
    text-align: center;
  }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-white);
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .footer__main {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer__brand {
      grid-column: 1 / -1;
      align-items: center;
      text-align: center;
    }

    .footer__tagline {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .footer__main {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer__nav,
    .footer__connect {
      align-items: center;
    }

    .footer__links {
      align-items: center;
    }

    .footer__social-row {
      justify-content: center;
    }
  }
</style>
