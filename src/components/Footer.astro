---
import { getSiteSettings, urlFor } from '../lib/sanity';
import LegalLinks from './LegalLinks.astro';

const settings = await getSiteSettings();

const exploreLinks = [
  { label: 'Home', href: '/' },
  { label: 'Media', href: '/media' },
  { label: 'Merch', href: '/merch' },
  { label: 'Rat Tales', href: '/rat-tales' },
  { label: 'Meet The Rat Pack', href: '/meet-the-rat-pack' },
  { label: 'Contact', href: '/contact' },
];

const socialSvgs: Record<string, string> = {
  facebook: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
  youtube: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
  tiktok: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>',
  twitter: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  instagram: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>',
  threads: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.781 3.631 2.695 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.74-1.762-.564-.63-1.43-.971-2.567-.99h-.139c-.871 0-2.064.219-2.85 1.494L6.847 7.917c1.04-1.687 2.722-2.694 4.96-2.694h.139c4.155.022 6.628 2.595 6.876 7.111.139.078.276.16.41.247 1.876 1.158 2.951 2.957 3.026 5.07.099 2.74-1.61 5.117-4.806 6.696-1.708.85-3.764 1.273-6.06 1.288l-.206.005Zm1.49-9.598c-.262 0-.527.008-.795.025-1.598.094-2.598.81-2.534 1.94.067 1.122 1.247 1.673 2.421 1.612 1.282-.07 2.751-.555 3-3.293a10.21 10.21 0 0 0-2.092-.284Z"/></svg>',
};

// Sanity stores socialLinks as an array of { platform, url } objects (not an
// object with named keys). Map platform values from the Sanity dropdown to
// the icon keys defined in socialSvgs above.
const platformToIcon: Record<string, string> = {
  Instagram: 'instagram',
  TikTok: 'tiktok',
  X: 'twitter',
  Twitter: 'twitter',
  Facebook: 'facebook',
  YouTube: 'youtube',
  Threads: 'threads',
};

type SocialLink = { platform: string; url: string };

const socialLinksRaw = (settings?.socialLinks ?? []) as SocialLink[];

// Build the icon row from the Sanity array, plus include the legacy
// top-level `youtubeChannel` field if present and not already in the array.
const socials: { icon: string; href: string; label: string }[] = [];

for (const s of socialLinksRaw) {
  const icon = platformToIcon[s?.platform];
  if (!s?.url || !icon) continue;
  socials.push({ icon, href: s.url, label: s.platform });
}

if (settings?.youtubeChannel && !socials.some((s) => s.icon === 'youtube')) {
  socials.push({ icon: 'youtube', href: settings.youtubeChannel, label: 'YouTube' });
}

const footerLogoUrl = settings?.footerLogo
  ? urlFor(settings.footerLogo).height(280).format('webp').url()
  : settings?.logo
    ? urlFor(settings.logo).height(280).format('webp').url()
    : null;

const footerText = settings?.footerText || 'Join the rebellion.\nUnleash the mischief.';
---

<footer class="footer">
  <div class="container">
    <div class="footer__main">
      <div class="footer__brand">
        {footerLogoUrl && (
          <img src={footerLogoUrl} alt="Labrats" class="footer__logo" />
        )}
        <p class="footer__tagline">
          {footerText.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              <em>{line}</em>
            </>
          ))}
        </p>
      </div>

      <nav class="footer__nav" aria-label="Explore navigation">
        <h3 class="footer__nav-title">Explore</h3>
        <ul class="footer__links">
          {exploreLinks.map(link => (
            <li>
              <a href={link.href} class="footer__link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer__nav" aria-label="Legal navigation">
        <h3 class="footer__nav-title">Legal</h3>
        <LegalLinks />
      </nav>

      <div class="footer__connect">
        <h3 class="footer__nav-title">Connect</h3>
        <div class="footer__social-row">
          {socials.map(s => (
            <a
              href={s.href}
              class="footer__social-icon"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              set:html={socialSvgs[s.icon]}
            ></a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        © {new Date().getFullYear()} Labrats. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-black);
    color: var(--color-white);
    padding: 64px 0 32px;
  }

  .footer__main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__logo {
    height: 140px;
    width: auto;
    align-self: flex-start;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--color-white);
    opacity: 0.8;
    line-height: 1.5;
    max-width: 260px;
  }

  .footer__nav-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-yellow);
    margin-bottom: 16px;
  }

  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0;
    margin: 0;
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-white);
    opacity: 0.8;
    transition: opacity 0.2s, color 0.2s;
    text-decoration: none;
  }

  .footer__link:hover {
    opacity: 1;
    color: var(--color-yellow);
  }

  .footer__connect {
    display: flex;
    flex-direction: column;
  }

  .footer__social-row {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .footer__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius);
    color: var(--color-yellow);
    transition: color 0.2s, background 0.2s;
  }

  .footer__social-icon:hover {
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-yellow) 20%, transparent);
  }

  .footer__bottom {
    border-top: 1px solid color-mix(in srgb, var(--color-white) 10%, transparent);
    padding-top: 24px;
    text-align: center;
  }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-white);
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .footer__main {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer__brand {
      grid-column: 1 / -1;
      align-items: center;
      text-align: center;
    }

    .footer__tagline {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .footer__main {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer__nav,
    .footer__connect {
      align-items: center;
    }

    .footer__links {
      align-items: center;
    }

    .footer__social-row {
      justify-content: center;
    }
  }
</style>
