---
import { getSiteSettings } from '../lib/sanity';
import SceneHero from './SceneHero.astro';

const settings = await getSiteSettings();
const trailerUrl = settings?.trailerYoutubeUrl || 'https://www.youtube.com/shorts/Q9OZvWO6H2c';
// Lab-escape scene, laid out like the other pages' heroes (dark left for the copy).
const HERO_IMG = '/images/heroes/home.webp';
---

<section class="hero has-scene">
  <SceneHero src={HERO_IMG} alt="The great lab escape: Sprocket Sparksqueak runs with a bubbling pink flask, Shadow Sneakerson swings on a cable and Nibbles McSqueak scurries along as MechaMouser 9000 gives chase" width={2048} height={1365} position="100% 40%" navOffset={160} />
  <div class="container hero__content-wrap">
    <div class="hero__content">
      <span class="section-label">The Adventure Begins</span>
      <h1 class="hero__title">
        Welcome to<br />
        <span class="hero__title-highlight">Labrats</span>
        <span class="hero__title-sub">Where Genius Meets Mischief!</span>
      </h1>
      <p class="hero__body">
        Step into the world of <strong>Labrats</strong> — an action-packed adventure bursting with daring escapes, wild inventions, and larger-than-life characters. A team of super-intelligent lab rats take on mad scientists, cybernetic threats, and epic missions in their fight for freedom.
      </p>
      <p class="hero__tagline">Genetically enhanced. Dangerously smart. Fighting for their freedom.</p>
      <div class="hero__ctas">
        <a href={trailerUrl} class="hero__btn hero__btn--teal" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M3 2l10 6-10 6V2z"/>
          </svg>
          Watch Our Trailer
        </a>
        <a href="/media" class="hero__btn hero__btn--yellow-outline">Explore Books</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scene layout comes from SceneHero; the big header is 160px tall from 1280px up, 80px below. */
  section.hero.has-scene {
    padding-top: 160px;
    min-height: calc(clamp(420px, 40vw, 720px) + 160px);
  }
  .hero__content-wrap { padding-top: 48px; padding-bottom: 64px; }
  /* the home copy is longer, so the scene starts a little further right */
  @media (min-width: 1025px) { .hero :global(.scene-hero__img) { width: 56%; } }
  .has-scene > .container > .hero__content { max-width: 540px !important; }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 1px;
    color: var(--color-white);
    margin-bottom: 8px;
  }
  .hero__title-highlight {
    display: block;
    color: var(--color-yellow);
    text-shadow: 0 0 40px color-mix(in srgb, var(--color-yellow) 40%, transparent);
    font-size: clamp(60px, 8.5vw, 120px);
    line-height: 0.9;
  }
  .hero__title-sub {
    display: block;
    font-size: clamp(24px, 3vw, 42px);
    color: var(--color-white);
    margin-top: 8px;
  }
  .hero__body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-white);
    margin: 20px 0 16px;
  }
  .hero__tagline {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--color-white);
    margin-bottom: 28px;
  }
  .hero__ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .hero__btn {
    display: inline-flex; align-items: center; gap: 8px;
    height: 48px; padding: 0 28px;
    font-family: var(--font-heading); font-size: 15px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    border-radius: 8px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }
  .hero__btn--teal { background: var(--color-teal); color: var(--color-black); border: 2px solid var(--color-teal); }
  .hero__btn--teal:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-teal) 40%, transparent);
    background: color-mix(in srgb, var(--color-teal) 85%, var(--color-white));
  }
  .hero__btn--yellow-outline { background: transparent; color: var(--color-yellow); border: 2px solid var(--color-yellow); }
  .hero__btn--yellow-outline:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-yellow) 30%, transparent);
    background: color-mix(in srgb, var(--color-yellow) 10%, transparent);
  }

  @media (max-width: 1279px) {
    section.hero.has-scene {
      padding-top: 80px;
      min-height: calc(clamp(420px, 40vw, 720px) + 80px);
    }
    .hero :global(.scene-hero__img) { top: 80px; height: calc(100% - 80px); }
    .hero :global(.scene-hero__shade) { top: 80px; }
  }
  @media (max-width: 768px) {
    .hero :global(.scene-hero__img) { top: 0; height: auto; margin-top: 80px; }
    .hero__content-wrap { padding-top: 0; }
  }
</style>
