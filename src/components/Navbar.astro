---
import { sanityImg } from '../lib/sanityImage';
import { getSiteSettings, urlFor } from '../lib/sanity';
import CartButton from './CartButton';
import { SOCIAL_LINKS } from '../lib/socialLinks';

const settings = await getSiteSettings();

/* A logo at a given display height: width-sized URLs (1x and 2x) and its
   intrinsic width/height, from the asset's own dimensions. */
function logoAt(source: any, displayH: number) {
  const base = urlFor(source).url();
  const m = base.match(/-(\d+)x(\d+)\.\w+/);
  const w = m ? Math.round(displayH * Number(m[1]) / Number(m[2])) : displayH * 2;
  return {
    src: sanityImg(base, w),
    srcset: `${sanityImg(base, w)} 1x, ${sanityImg(base, w * 2)} 2x`,
    width: w,
    height: displayH,
  };
}
// Shown 168px high (72px on small screens).
const logo = settings?.logo
  ? logoAt(settings.logo, 168)
  : { src: 'https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1440,h=756,fit=crop,f=jpeg/Aq2q3anW6qTLnbeK/labrats-landscape-jul25-YZ9jxZw971UBgjew.png' };

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Meet The Rat Pack', href: '/meet-the-rat-pack' },
  { label: 'Media', href: '/media' },
  { label: 'Games', href: '/games' },
  { label: 'Merch', href: '/merch' },
  { label: 'Rat Tales', href: '/rat-tales' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="navbar" id="navbar">
  <div class="container navbar__inner">
    <a href="/" class="navbar__logo" aria-label="Labrats Home">
      <img
        {...logo}
        alt="Labrats logo"
        class="navbar__logo-img"
      />
    </a>

    <nav class="navbar__nav" role="navigation" aria-label="Main navigation">
      <ul class="navbar__links">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="navbar__link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="navbar__right">
      <div class="navbar__socials">
        {SOCIAL_LINKS.map((link) => (
          <a href={link.href} class="navbar__social-icon" target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={link.path}/></svg>
          </a>
        ))}
      </div>

      <CartButton client:load />

      <button class="navbar__toggle" id="navToggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="navbar__mobile" id="mobileMenu">
    <ul class="navbar__mobile-links">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="navbar__mobile-link">{link.label}</a>
        </li>
      ))}
    </ul>
    <div class="navbar__mobile-socials">
      {SOCIAL_LINKS.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={link.path}/></svg>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      navbar?.classList.add('navbar--scrolled');
    } else {
      navbar?.classList.remove('navbar--scrolled');
    }
  });

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('navbar__mobile--open');
    toggle.classList.toggle('navbar__toggle--open');
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0;
    background: var(--color-teal);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .navbar--scrolled {
    background: var(--color-teal);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 24px color-mix(in srgb, var(--color-teal) 40%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-black) 15%, transparent);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 160px;
  }

  .navbar__logo {
    flex-shrink: 0;
  }

  .navbar__logo-img {
    height: 168px;
    width: auto;
    border-radius: 0;
    transition: opacity 0.2s;
  }

  .navbar__logo-img:hover {
    opacity: 0.85;
  }

  .navbar__nav {
    flex: 1;
  }

  .navbar__links {
    display: flex;
    list-style: none;
    gap: 8px;
  }

  .navbar__link {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-white);
    /* 12px (was 16) so seven links fit on one line from 1280px, as six did. */
    padding: 8px 12px;
    border-radius: var(--radius);
    transition: color 0.2s, background 0.2s;
  }

  .navbar__link:hover {
    color: var(--color-yellow);
    background: color-mix(in srgb, var(--color-black) 12%, transparent);
  }

  .navbar__right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .navbar__socials {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 16px;
    padding-left: 16px;
    border-left: 1px solid color-mix(in srgb, var(--color-black) 20%, transparent);
  }

  .navbar__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    padding: 8px;
    border-radius: var(--radius);
    transition: color 0.2s, background 0.2s;
  }

  .navbar__social-icon:hover {
    color: var(--color-yellow);
    background: color-mix(in srgb, var(--color-black) 12%, transparent);
  }

  .navbar__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    cursor: pointer;
  }

  .navbar__toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-white);
    transition: 0.3s;
    border-radius: 2px;
  }

  .navbar__toggle--open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .navbar__toggle--open span:nth-child(2) {
    opacity: 0;
  }

  .navbar__toggle--open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .navbar__mobile {
    display: none;
    flex-direction: column;
    gap: 8px;
    padding: 16px 24px 24px;
    background: var(--color-teal);
    border-top: 1px solid color-mix(in srgb, var(--color-black) 15%, transparent);
  }

  .navbar__mobile--open {
    display: flex;
  }

  .navbar__mobile-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .navbar__mobile-link {
    display: block;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-white);
    padding: 12px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-black) 15%, transparent);
    transition: color 0.2s;
  }

  .navbar__mobile-link:hover {
    color: var(--color-yellow);
  }

  .navbar__mobile-socials {
    display: flex;
    gap: 16px;
    justify-content: center;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--color-black) 15%, transparent);
  }

  .navbar__mobile-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    padding: 8px;
    border-radius: var(--radius);
    transition: color 0.2s;
  }

  .navbar__mobile-socials a:hover {
    color: var(--color-yellow);
  }

  @media (max-width: 768px) {
    .navbar__inner {
      height: 80px;
      gap: 16px;
      justify-content: space-between;
    }

    .navbar__logo-img {
      height: 72px;
    }

    .navbar__nav {
      display: none;
    }

    .navbar__right {
      margin-left: auto;
    }

    .navbar__socials {
      display: none;
    }

    .navbar__toggle {
      display: flex;
    }
  }
</style>
