---
// Cloudflare Turnstile site key: public, baked in at build time, so a change
// in Netlify needs a rebuild. Without it the form renders no widget and
// /api/subscribe refuses its sign-ups.
const TURNSTILE_SITE_KEY =
  import.meta.env.TURNSTILE_SITE_KEY || process.env.TURNSTILE_SITE_KEY || '';
---

<section class="newsletter" id="newsletter">
  <div class="container newsletter__content">
    <div class="newsletter__inner">
      <h2 class="newsletter__title">Stay Squeaky Informed</h2>
      <form
        class="newsletter__form"
        id="newsletterForm"
      >
        <div class="newsletter__input-wrap">
          <input
            type="email"
            id="nl-email"
            name="email"
            placeholder="Enter your email address..."
            class="newsletter__input"
            required
            autocomplete="email"
          />
          {/* Disabled until the script below is listening, so an early press is
              not a native GET with the email in the URL. */}
          <button type="submit" class="newsletter__submit" disabled>
            Subscribe
          </button>
        </div>
        {/* Honeypot: off-screen, unreachable by pointer, keyboard or screen
            reader, with a name autofill does not recognise. Checked in
            netlify/functions/subscribe.mts. */}
        <div class="newsletter__extra" aria-hidden="true">
          <label for="lr-nl-extra">Extra</label>
          <input type="text" id="lr-nl-extra" name="lr_nl_extra" tabindex="-1" autocomplete="off" />
        </div>
        {TURNSTILE_SITE_KEY && (
          <div
            class="cf-turnstile newsletter__turnstile"
            data-sitekey={TURNSTILE_SITE_KEY}
            data-action="newsletter"
            data-response-field-name="cf-turnstile-response"
          ></div>
        )}
        <p class="newsletter__note">No spam, unsubscribe anytime. Rat's honour.</p>
        <p class="newsletter__message" id="nl-message" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </div>
</section>

{TURNSTILE_SITE_KEY && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<style>
  .newsletter {
    background: var(--color-teal);
    padding: 64px 0;
  }

  .newsletter__content {
    display: flex;
    justify-content: center;
  }

  .newsletter__inner {
    max-width: 640px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .newsletter__title {
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    color: var(--color-white);
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
  }

  .newsletter__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .newsletter__input-wrap {
    display: flex;
    width: 100%;
    max-width: 520px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-white) 30%, transparent);
  }

  .newsletter__input {
    flex: 1;
    background: color-mix(in srgb, var(--color-white) 20%, transparent);
    border: none;
    padding: 16px 20px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-white);
    outline: none;
    transition: background 0.2s;
  }

  .newsletter__input::placeholder {
    color: color-mix(in srgb, var(--color-white) 70%, transparent);
  }

  .newsletter__input:focus {
    background: color-mix(in srgb, var(--color-white) 28%, transparent);
  }

  .newsletter__submit {
    flex-shrink: 0;
    padding: 16px 28px;
    white-space: nowrap;
    background: var(--color-yellow);
    color: var(--color-black);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }

  .newsletter__submit:hover {
    background: color-mix(in srgb, var(--color-yellow) 85%, var(--color-white));
  }

  .newsletter__extra {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .newsletter__turnstile {
    min-height: 65px;
  }

  .newsletter__note {
    font-size: 13px;
    color: color-mix(in srgb, var(--color-white) 80%, transparent);
    font-style: italic;
  }

  .newsletter__submit:disabled {
    cursor: progress;
    opacity: 0.75;
  }

  /* Result of the signup. Stays on screen (no timeout) and is announced
     through the live region. */
  .newsletter__message {
    margin: 0;
    max-width: 520px;
    width: 100%;
    padding: 14px 20px;
    border-radius: var(--radius);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.4;
  }

  .newsletter__message[hidden] {
    display: none;
  }

  .newsletter__message--success {
    background: var(--color-yellow);
    color: var(--color-black);
  }

  .newsletter__message--error {
    background: color-mix(in srgb, var(--color-black) 75%, transparent);
    color: var(--color-white);
    font-weight: 600;
  }

  /* After a successful signup the input row steps aside for the message. */
  .newsletter__form--done .newsletter__input-wrap,
  .newsletter__form--done .newsletter__turnstile,
  .newsletter__form--done .newsletter__note {
    display: none;
  }

  @media (max-width: 600px) {
    .newsletter__input-wrap {
      flex-direction: column;
      border-radius: var(--radius-lg);
      overflow: visible;
      box-shadow: none;
      gap: 8px;
    }

    .newsletter__input {
      border-radius: var(--radius);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-white) 30%, transparent);
    }

    .newsletter__submit {
      border-radius: var(--radius);
      width: 100%;
    }
  }
</style>

<script>
  const nlForm = document.getElementById('newsletterForm') as HTMLFormElement | null;
  const nlInput = document.getElementById('nl-email') as HTMLInputElement | null;
  const nlBtn = nlForm?.querySelector('.newsletter__submit') as HTMLButtonElement | null;
  const nlMsg = document.getElementById('nl-message');
  const nlBtnText = nlBtn?.textContent?.trim() || 'Subscribe';
  // Time on page: stamped now, compared with the submit time by the function.
  const nlLoadedAt = Date.now();
  const nlWidget = nlForm?.querySelector('.cf-turnstile') as HTMLElement | null;
  const nlToken = () =>
    (nlForm?.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value?.trim() || '';
  // A Turnstile token is single use: reset the widget after any failed attempt.
  function resetTurnstile() {
    const ts = (window as any).turnstile;
    if (nlWidget && ts && typeof ts.reset === 'function') {
      try { ts.reset(nlWidget); } catch { /* not rendered yet */ }
    }
  }

  // A message that stays on screen and is read out. Before, the only feedback
  // was the button label changing for four seconds while the field cleared,
  // which visitors missed.
  function showMessage(kind: 'success' | 'error', text: string) {
    if (!nlMsg) return;
    nlMsg.textContent = text;
    nlMsg.classList.toggle('newsletter__message--success', kind === 'success');
    nlMsg.classList.toggle('newsletter__message--error', kind === 'error');
    nlMsg.hidden = false;
  }

  function setSending(on: boolean) {
    if (!nlBtn) return;
    nlBtn.disabled = on;
    nlBtn.textContent = on ? 'Subscribing...' : nlBtnText;
  }

  let nlInFlight = false;

  nlForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (nlInFlight) return;
    const email = nlInput?.value?.trim();
    if (!email) return;
    if (nlWidget && !nlToken()) {
      showMessage('error', 'Please complete the anti-spam check first.');
      return;
    }

    if (nlMsg) nlMsg.hidden = true;
    nlInFlight = true;
    setSending(true);

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          turnstileToken: nlToken(),
          lr_nl_extra: (nlForm.querySelector('input[name="lr_nl_extra"]') as HTMLInputElement | null)?.value || '',
          lr_nl_ts_load: nlLoadedAt,
          lr_nl_ts_submit: Date.now(),
        })
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.ok) {
        // The same reply whoever the address belongs to (see subscribe.mts).
        showMessage('success', "Nearly there! If you're new, check your inbox and click the link to confirm.");
        nlForm.classList.add('newsletter__form--done');
        if (nlInput) nlInput.value = '';
      } else {
        // Keep what they typed so they can fix it and try again.
        // The function's own reason for a 4xx (e.g. a bad address); for a
        // server-side failure the generic line, not internal wording.
        const reason =
          res.status < 500 && typeof data?.error === 'string' ? data.error.replace(/\.?$/, '.') : '';
        showMessage('error', reason || "Couldn't sign you up just now. Please try again.");
        resetTurnstile();
      }
    } catch {
      showMessage('error', "Couldn't reach the lab just now. Please try again.");
      resetTurnstile();
    } finally {
      nlInFlight = false;
      setSending(false);
    }
  });

  // Listening now; the button was rendered disabled until this point.
  setSending(false);
</script>
