---
// Vent Runner banner: the game's title card artwork, with the game title painted
// into the art and no Labrats logo (Nov 2026: title cards carry only the game's
// own title; we are already on the Labrats site). The heading stays in the page
// for screen readers and search, visually hidden.
// Used by the /games hub card (h2), eager.
interface Props {
  heading?: 'h1' | 'h2';
  loading?: 'eager' | 'lazy';
  /** The rendered width of the banner, for the srcset. */
  sizes: string;
  class?: string;
}

const { heading = 'h2', loading = 'lazy', sizes, class: className } = Astro.props;
const Heading = heading;
const DIR = '/games/vent-runner/img/banner/vent-runner-title';
---

<div class:list={['vr-banner', className]}>
  <Heading class="vr-banner__heading">Vent Runner</Heading>
  <picture class="vr-banner__art">
    <source type="image/webp" srcset={`${DIR}-960.webp 960w, ${DIR}-1600.webp 1600w`} sizes={sizes} />
    <img
      src={`${DIR}-1600.jpg`}
      alt="Vent Runner: MechaMouser 9000, Shadow Sneakerson, Dr. Basil Whiskerworth and Ludwig Fenrir under a security drone"
      width="1600"
      height="900"
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      decoding="async"
    />
  </picture>
</div>

<style>
  .vr-banner {
    /* kept so pages that set it still work */
    --vr-banner-bg: var(--color-black);
    position: relative;
  }

  .vr-banner__heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .vr-banner__art {
    display: block;
  }

  .vr-banner__art img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
